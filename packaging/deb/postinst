#!/bin/sh
set -e

if [ -d /run/systemd/system ]; then
  systemctl daemon-reload || true
  systemctl enable easy-helper.service >/dev/null 2>&1 || true
  systemctl restart easy-helper.service >/dev/null 2>&1 || \
    systemctl start easy-helper.service >/dev/null 2>&1 || true
fi

if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
fi

if command -v gtk-update-icon-cache >/dev/null 2>&1 && [ -d /usr/share/icons/hicolor ]; then
  gtk-update-icon-cache -q /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi

if command -v update-mime-database >/dev/null 2>&1 && [ -d /usr/share/mime ]; then
  update-mime-database /usr/share/mime >/dev/null 2>&1 || true
fi

echo "Easy Connection is installed."
echo "  App menu: search for \"Easy Connection\""
echo "  CLI:      easy --help"
echo "  Helper:   systemctl status easy-helper.service"
exit 0
